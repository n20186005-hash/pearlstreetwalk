---
import '../styles/global.css';
import{SITE,MAPS}from'../data/guide';
interface Props{title:string;description:string;path?:string;noindex?:boolean;}
const{title,description,path='/',noindex=false}=Astro.props;const canonical=SITE+path;
---
<!doctype html><html lang="en-US"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><title>{title}</title><meta name="description" content={description}/>{!noindex&&<link rel="canonical" href={canonical}/>}{noindex&&<meta name="robots" content="noindex,follow"/>}
<meta property="og:type" content="website"/><meta property="og:site_name" content="Pearl Street Mall independent guide"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/>{!noindex&&<meta property="og:url" content={canonical}/>}<meta property="og:image" content={SITE+'/images/hero.jpg'}/><meta property="og:image:alt" content="Pearl Street streetscape photographed in December 2025; historical cropped image"/>
<meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={SITE+'/images/hero.jpg'}/><meta name="twitter:image:alt" content="Historical Pearl Street streetscape, December 2025"/><meta name="theme-color" content="#1e2926"/>
<link rel="manifest" href="/manifest.webmanifest"/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/><link rel="icon" href="/favicon-32.png" sizes="32x32"/><link rel="icon" href="/favicon-16.png" sizes="16x16"/><link rel="apple-touch-icon" href="/apple-touch-icon.png"/><slot name="head"/>
</head><body><a class="skip-link" href="#main">Skip to content</a><header class="site-header"><div class="header-inner"><a href="/" aria-label="Pearl Street guide home"><img src="/logo.svg" width="210" height="63" alt="Pearl Street Mall guide"/></a><details class="site-menu"><summary>Menu ☰</summary><nav aria-label="Main navigation">{[['About','about'],['Visit & parking','plan'],['Dining','eat'],['Separate destinations','nearby'],['Map & reviews','reviews'],['FAQ','faq'],['Sources','sources'],['Privacy','privacy']].map(([label,id])=><a href={'/#'+id}>{label}</a>)}</nav></details><a class="map-button" href={MAPS} target="_blank" rel="noopener noreferrer">Map ↗</a></div></header><main id="main"><slot/></main><footer class="site-footer"><div class="container"><img src="/logo.svg" width="190" height="57" alt="Pearl Street Mall guide"/><p>This independent, unofficial, nonprofit tourism and educational guide is not affiliated with the City of Boulder, Downtown Boulder Partnership or listed businesses. It does not sell tickets or take reservations.</p><a href="/#privacy">Privacy and analytics</a> · <a href="/#sources">Sources and image licence</a></div></footer>
<script is:inline>if('serviceWorker'in navigator){window.addEventListener('load',()=>{navigator.serviceWorker.getRegistrations().then(rs=>{for(const r of rs)if(r.active?.scriptURL===location.origin+'/sw.js')r.update();}).catch(()=>{});});}</script>
</body></html>
