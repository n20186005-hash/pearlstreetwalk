---
import '../styles/global.css';
const site = Astro.site;
const canonical = site ? new URL(Astro.url.pathname, site).toString() : undefined;
const ogImage = site ? new URL('/logo.svg', site).toString() : undefined;
const mapUrl = 'https://www.google.com/maps?q=Pearl+Street+Mall,+1303+Pearl+St,+Boulder,+CO+80302&output=embed&hl=en&gl=us';
const photo = {
  hero:'https://commons.wikimedia.org/wiki/Special:Redirect/file/Pearl_Street_Mall_%2855028393862%29.jpg?width=1920',
  summer:'https://commons.wikimedia.org/wiki/Special:Redirect/file/Pearl_Street_Mall.jpg?width=1400',
  lawn:'https://commons.wikimedia.org/wiki/Special:Redirect/file/Pearl_Street_Mall_from_courthouse_lawn.JPG?width=1400',
  performer:'https://commons.wikimedia.org/wiki/Special:Redirect/file/Sam_Malcolm_Street_Performs_August_29th_2014.jpg?width=1200'
};
const placeLd:any = {
  '@context':'https://schema.org','@type':['TouristAttraction','LocalBusiness'],name:'Pearl Street Mall',
  description:'A four-block pedestrian mall and city park in historic downtown Boulder, Colorado, lined with shops, restaurants, public art and street life.',
  address:{'@type':'PostalAddress',streetAddress:'1303 Pearl St',addressLocality:'Boulder',addressRegion:'CO',postalCode:'80302',addressCountry:'US'},
  geo:{'@type':'GeoCoordinates',latitude:40.018351,longitude:-105.2786591},
  telephone:'+1-303-449-3774',isAccessibleForFree:true,
  openingHoursSpecification:[{'@type':'OpeningHoursSpecification',dayOfWeek:['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'],opens:'00:00',closes:'23:59'}],
  aggregateRating:{'@type':'AggregateRating',ratingValue:'4.6',reviewCount:'10686',bestRating:'5',worstRating:'1'}
};
if (canonical) placeLd.url = canonical;
const faqs = [
  ['Is Pearl Street Mall free to visit?','Yes. The pedestrian mall itself is a public outdoor space with no admission fee. Purchases, dining, performances and ticketed events are separate.'],
  ['When is the best time to visit?','Late morning through early evening gives you the broadest mix of open shops, patios and street activity. Summer evenings are lively; shoulder seasons are calmer.'],
  ['How long should I plan to stay?','About 1.5–3 hours works well for a first visit, with more time if you plan a meal, shopping, a museum stop or an event.'],
  ['Where should I park?','City of Boulder operates multiple downtown garages close to Pearl Street, including 15th & Pearl, 14th & Walnut, 11th & Walnut and 11th & Spruce. Check current city rates before arrival.'],
  ['Are business hours the same as the mall hours?','No. The outdoor pedestrian space is accessible at all hours, but every shop, restaurant, visitor service and event sets its own schedule.']
];
const faqLd = {'@context':'https://schema.org','@type':'FAQPage',mainEntity:faqs.map(([q,a])=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}}))};
---
<!doctype html>
<html lang="en-US">
<head>
<meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/>
<title>Pearl Street Mall — A Local-Style Guide to Downtown Boulder</title>
<meta name="description" content="Plan a visit to Pearl Street Mall in Boulder: parking, transit, food, nearby sights, costs, best time to go and practical local tips."/>
{canonical && <link rel="canonical" href={canonical}/>}<meta property="og:title" content="Pearl Street Mall — Boulder, Colorado"/><meta property="og:description" content="A practical, design-led visitor guide to Boulder's four-block pedestrian heart."/><meta property="og:type" content="website"/>{canonical && <meta property="og:url" content={canonical}/>} {ogImage && <meta property="og:image" content={ogImage}/>}<meta name="twitter:card" content="summary_large_image"/>
<link rel="icon" href="/favicon.svg" type="image/svg+xml"/><link rel="icon" href="/favicon-32.png" sizes="32x32"/><link rel="icon" href="/favicon-16.png" sizes="16x16"/><link rel="apple-touch-icon" href="/apple-touch-icon.png"/>
<script async src="https://www.googletagmanager.com/gtag/js?id=G-HXM22WWPKP"></script><script is:inline>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-HXM22WWPKP');</script>
<script type="application/ld+json" set:html={JSON.stringify(placeLd)}></script><script type="application/ld+json" set:html={JSON.stringify(faqLd)}></script>
</head>
<body>
<header class="absolute inset-x-0 top-0 z-30"><div class="mx-auto flex max-w-7xl items-center justify-between px-5 py-5"><a href="#top" class="focus-ring rounded-xl bg-[#f7f0e4]/95 p-2 shadow-lg"><img src="/logo.svg" width="210" height="63" alt="Pearl Street Mall"/></a><nav class="hidden gap-6 rounded-full bg-[#1e2926]/80 px-6 py-3 text-sm font-semibold text-white backdrop-blur md:flex"><a href="#plan">Plan</a><a href="#eat">Eat</a><a href="#nearby">Nearby</a><a href="#faq">FAQ</a></nav></div></header>
<main id="top">
<section class="relative min-h-[92vh] overflow-hidden bg-[#1e2926] text-white"><img src={photo.hero} alt="Pearl Street Mall pedestrian promenade in Boulder" class="absolute inset-0 h-full w-full object-cover opacity-70"/><div class="absolute inset-0 bg-gradient-to-t from-[#17211e] via-[#17211e]/30 to-transparent"></div><div class="relative mx-auto flex min-h-[92vh] max-w-7xl items-end px-5 pb-16 pt-36"><div class="max-w-4xl"><div class="mb-5 inline-flex rounded-full border border-white/30 bg-black/20 px-4 py-2 text-xs font-bold uppercase tracking-[.2em] backdrop-blur">Four brick blocks • Downtown Boulder</div><h1 class="font-serif text-[clamp(4rem,11vw,9rem)] leading-[.78] tracking-[-.055em]">Pearl<br/>Street Mall</h1><p class="mt-7 max-w-2xl text-lg leading-8 text-white/88">Boulder’s pedestrian heart: historic storefronts, mountain-town energy, patios, independent shops, public art and the kind of street performance that makes you stop mid-walk.</p><div class="mt-8 flex flex-wrap gap-3 text-sm"><span class="rounded-full bg-[#f7f0e4] px-4 py-2 font-bold text-[#1e2926]">★ 4.6 · 10,686 reviews</span><span class="rounded-full border border-white/35 px-4 py-2">Free public space</span><span class="rounded-full border border-white/35 px-4 py-2">11th–15th Streets</span></div></div></div></section>
<section class="brick-grid px-5 py-24"><div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-[1.2fr_.8fr]"><div><p class="eyebrow">Why it feels like Boulder</p><h2 class="section-title mt-3">Not a mall.<br/>A civic living room.</h2><p class="mt-7 max-w-2xl text-lg leading-8 text-black/70">The four-block pedestrian mall opened as a public park in 1977 after Boulder converted this stretch of Pearl Street from car traffic into a walk-first urban space. Brick paving, gathering nodes, play features, trees and street-scale retail remain the defining experience.</p></div><div class="card p-7"><p class="font-serif text-3xl">Quick read</p><dl class="mt-6 grid grid-cols-2 gap-5 text-sm"><div><dt class="text-black/45">Address</dt><dd class="mt-1 font-bold">1303 Pearl St<br/>Boulder, CO 80302</dd></div><div><dt class="text-black/45">Phone</dt><dd class="mt-1 font-bold">303-449-3774</dd></div><div><dt class="text-black/45">Core length</dt><dd class="mt-1 font-bold">4 pedestrian blocks</dd></div><div><dt class="text-black/45">Best pace</dt><dd class="mt-1 font-bold">1.5–3 hours</dd></div></dl></div></div></section>
<section class="bg-[#9f3f2f] px-5 py-24 text-[#fffaf2]"><div class="mx-auto max-w-7xl"><p class="text-xs font-bold uppercase tracking-[.18em] text-[#f2c98e]">Street character</p><div class="mt-5 grid gap-5 md:grid-cols-3"><figure class="overflow-hidden rounded-[2rem]"><img src={photo.summer} class="h-96 w-full object-cover" alt="Tree-lined brick walk on Pearl Street Mall"/><figcaption class="p-4 text-sm text-white/75">Tree shade + brick paving</figcaption></figure><figure class="overflow-hidden rounded-[2rem] md:translate-y-12"><img src={photo.lawn} class="h-96 w-full object-cover" alt="Pearl Street Mall seen from courthouse lawn"/><figcaption class="p-4 text-sm text-white/75">Civic spaces woven into downtown</figcaption></figure><figure class="overflow-hidden rounded-[2rem]"><img src={photo.performer} class="h-96 w-full object-cover" alt="Street performer on Pearl Street"/><figcaption class="p-4 text-sm text-white/75">Buskers are part of the rhythm</figcaption></figure></div></div></section>
<section id="plan" class="px-5 py-24"><div class="mx-auto max-w-7xl"><p class="eyebrow">Plan your visit</p><h2 class="section-title mt-3">Make the bricks easy.</h2><div class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-4"><article class="card p-6"><h3 class="font-serif text-2xl">Fees</h3><p class="mt-3 leading-7 text-black/65">No admission fee for the pedestrian mall. Shopping, meals and ticketed programs are separate.</p></article><article class="card p-6"><h3 class="font-serif text-2xl">Best time</h3><p class="mt-3 leading-7 text-black/65">Late morning to early evening for the fullest mix of businesses and street life. Summer evenings are the most animated.</p></article><article class="card p-6"><h3 class="font-serif text-2xl">Stay length</h3><p class="mt-3 leading-7 text-black/65">1.5–3 hours for browsing and a snack; half a day if you add a sit-down meal, museum or nearby trail.</p></article><article class="card p-6"><h3 class="font-serif text-2xl">Accessibility</h3><p class="mt-3 leading-7 text-black/65">The city lists accessible sidewalks/paths, benches and drinking fountains. Cross-street grades and crowds can vary.</p></article></div>
<div class="mt-16 grid gap-6 lg:grid-cols-2"><article class="card p-8"><p class="eyebrow">Detailed transportation</p><h3 class="mt-2 font-serif text-3xl">Arrive without the circling.</h3><div class="mt-6 space-y-5 leading-7 text-black/68"><p><b>By bus:</b> Downtown Boulder is served by RTD; the downtown station sits near 14th & Walnut, roughly a block from the mall.</p><p><b>By bike:</b> Boulder’s bike network connects downtown with the Boulder Creek corridor. Use signed bike parking and walk your bike when crowds are dense.</p><p><b>On foot:</b> The core pedestrian mall runs from 11th to 15th Street; Pearl Street continues beyond both ends with more shops and dining.</p></div></article><article class="card p-8"><p class="eyebrow">Parking</p><h3 class="mt-2 font-serif text-3xl">Use a city garage first.</h3><p class="mt-5 leading-7 text-black/68">Convenient downtown garages include 15th & Pearl, 14th & Walnut, 11th & Walnut and 11th & Spruce. City garage pricing changes, so confirm rates before arrival; weekends and city holidays are often free in downtown city garages, with listed exceptions.</p><p class="mt-4 rounded-2xl bg-[#eef1e9] p-4 text-sm">Tip: special events can fill the closest facilities quickly. A garage two or three blocks away is often faster than hunting curb space.</p></article></div></div></section>
<section id="eat" class="bg-[#294e3d] px-5 py-24 text-white"><div class="mx-auto max-w-7xl"><p class="text-xs font-bold uppercase tracking-[.18em] text-[#e6bf82]">Food nearby</p><h2 class="section-title mt-3">Eat right on the walk.</h2><div class="mt-10 grid gap-5 md:grid-cols-3"><article class="rounded-3xl bg-white/9 p-7"><h3 class="font-serif text-3xl">OAK at Fourteenth</h3><p class="mt-3 leading-7 text-white/70">Seasonal New American cooking and cocktails directly on Pearl Street.</p><p class="mt-4 text-sm font-bold text-[#f0cc92]">1400 Pearl St</p></article><article class="rounded-3xl bg-white/9 p-7"><h3 class="font-serif text-3xl">The Kitchen</h3><p class="mt-3 leading-7 text-white/70">Modern American bistro with a lively downtown dining room.</p><p class="mt-4 text-sm font-bold text-[#f0cc92]">1039 Pearl St</p></article><article class="rounded-3xl bg-white/9 p-7"><h3 class="font-serif text-3xl">Postino Boulder</h3><p class="mt-3 leading-7 text-white/70">Wine-café energy, shareable boards and a wraparound patio near the east end.</p><p class="mt-4 text-sm font-bold text-[#f0cc92]">1468 Pearl St</p></article></div><p class="mt-6 text-sm text-white/55">Restaurant hours and menus change; verify directly before making a special trip.</p></div></section>
<section id="nearby" class="px-5 py-24"><div class="mx-auto max-w-7xl"><p class="eyebrow">Nearby sights</p><h2 class="section-title mt-3">Add one more Boulder layer.</h2><div class="mt-10 grid gap-5 lg:grid-cols-3"><article class="card p-7"><span class="text-4xl">▰</span><h3 class="mt-6 font-serif text-3xl">Museum of Boulder</h3><p class="mt-3 leading-7 text-black/65">A compact local-history stop north of Pearl Street, easy to pair with shopping.</p></article><article class="card p-7"><span class="text-4xl">◒</span><h3 class="mt-6 font-serif text-3xl">Boulder Creek Path</h3><p class="mt-3 leading-7 text-black/65">A quick shift from downtown brick to creekside walking and biking.</p></article><article class="card p-7"><span class="text-4xl">▲</span><h3 class="mt-6 font-serif text-3xl">The People’s Crossing</h3><p class="mt-3 leading-7 text-black/65">At the west end of Pearl, a trailhead gives a fast taste of Boulder’s red-rock foothills.</p></article></div></div></section>
<section class="px-5 pb-24"><div class="mx-auto max-w-7xl overflow-hidden rounded-[2rem] bg-[#1e2926]"><div class="grid lg:grid-cols-[.72fr_1.28fr]"><div class="p-8 text-white lg:p-12"><p class="text-xs font-bold uppercase tracking-[.18em] text-[#e6bf82]">Map</p><h2 class="mt-3 font-serif text-4xl">Find the center of the bricks.</h2><p class="mt-5 leading-7 text-white/65">The Visitor Information Center is at 1303 Pearl Street, near 13th Street, right in the pedestrian core.</p><a class="focus-ring mt-7 inline-block rounded-full bg-[#f7f0e4] px-5 py-3 text-sm font-bold text-[#1e2926]" href="https://maps.app.goo.gl/fuuru9b7xVfarpap6" target="_blank" rel="noopener">Open in Google Maps ↗</a></div><iframe class="min-h-[480px] w-full border-0" src={mapUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="Google Map of Pearl Street Mall"></iframe></div></div></section>
<section id="faq" class="bg-[#efe4d2] px-5 py-24"><div class="mx-auto max-w-5xl"><p class="eyebrow">FAQ</p><h2 class="section-title mt-3">Before you go.</h2><div class="mt-10 divide-y divide-black/10">{faqs.map(([q,a])=><details class="group py-5"><summary class="cursor-pointer list-none font-serif text-2xl font-bold">{q}<span class="float-right text-[#9f3f2f] group-open:rotate-45">+</span></summary><p class="mt-4 max-w-3xl leading-7 text-black/65">{a}</p></details>)}</div></div></section>
<section class="px-5 py-16"><div class="mx-auto max-w-7xl text-sm text-black/55"><p><b>Photo credits:</b> Wikimedia Commons images used under their listed Creative Commons licenses. Primary recent streetscape: Jesse James, CC BY 4.0; classic mall photo: Lee Coursey, CC BY 2.0; courthouse lawn: Kvng, CC BY-SA 3.0. See source file pages on Wikimedia Commons for full attribution.</p></div></section>
</main><footer class="bg-[#17211e] px-5 py-10 text-sm text-white/60"><div class="mx-auto flex max-w-7xl flex-col gap-4 md:flex-row md:items-center md:justify-between"><img src="/logo.svg" width="190" height="57" alt="Pearl Street Mall"/><p>This independent visitor guide is not an official City of Boulder or Downtown Boulder website.</p></div></footer>
</body></html>
