---
import '../styles/global.css';

// ---- Single-attraction SEO entity bindings (filled from the template variables) ----
const DOMAIN = 'pearlstreetwalk.com';
const FULL_NAME = 'Pearl Street Mall';          // {{ATTRACTION_FULL_NAME}}
const SHORT_NAME = 'Pearl Street Walk';         // {{ATTRACTION_SHORT_NAME}} (domain meaning)
const CITY = 'Boulder';                         // {{CITY_NAME}}
const STATE = 'Colorado';                       // {{STATE_PROVINCE}}
const STATE_CODE = 'CO';
const COUNTRY = 'United States';               // {{COUNTRY_NAME}}
const CC = 'US';                               // {{COUNTRY_CODE_2LETTER}}
const POSTAL = '80302';                        // {{POSTAL_CODE}}
const LAT = 40.018351;                         // {{LATITUDE}}
const LNG = -105.2786591;                      // {{LONGITUDE}}
const MAPS_SHARE = 'https://maps.app.goo.gl/fuuru9b7xVfarpap6'; // {{MAPS_SHARE_URL}}
const MAPS_EMBED = 'https://www.google.com/maps?q=Pearl+Street+Mall,+1303+Pearl+St,+Boulder,+CO+80302&output=embed&hl=en&gl=us'; // {{MAPS_EMBED_SRC}}
const NEARBY_1 = 'Museum of Boulder';          // {{NEARBY_LANDMARK_1}}
const NEARBY_2 = 'Boulder Creek Path';         // {{NEARBY_LANDMARK_2}}
const GOVT_TOURISM = 'https://bouldercolorado.gov'; // {{GOVT_TOURISM_URL}}

// Ratings synced from Google Maps (display only — NOT in JSON-LD)
const RATING = '4.6';
const REVIEWS = '10,686';
const SYNC_LABEL = '2026 年 9 月';

const siteUrl = Astro.site ? Astro.site.origin : `https://${DOMAIN}`;
const canonical = `${siteUrl}/`;
const ogImage = `${siteUrl}/images/hero.jpg`;
const mapUrl = MAPS_EMBED;

const photo = {
  hero:'https://commons.wikimedia.org/wiki/Special:Redirect/file/Pearl_Street_Mall_%2855028393862%29.jpg?width=1920',
  summer:'https://commons.wikimedia.org/wiki/Special:Redirect/file/Pearl_Street_Mall.jpg?width=1400',
  lawn:'https://commons.wikimedia.org/wiki/Special:Redirect/file/Pearl_Street_Mall_from_courthouse_lawn.JPG?width=1400',
  performer:'https://commons.wikimedia.org/wiki/Special:Redirect/file/Sam_Malcolm_Street_Performs_August_29th_2014.jpg?width=1200'
};

// ---- 1. Structured data (Schema.org / JSON-LD) ----
const placeLd:any = {
  '@context':'https://schema.org',
  '@type':'TouristAttraction',
  '@id':`${siteUrl}/#attraction`,
  'name':FULL_NAME,
  'alternateName':[SHORT_NAME, `${CITY} ${FULL_NAME}`],
  'description':`Comprehensive visitor guide to ${FULL_NAME} in ${CITY}, ${STATE}, ${COUNTRY}.`,
  'url':siteUrl,
  'image':[ogImage],
  'isAccessibleForFree':true,
  'telephone':'+1-303-449-3774',
  'address':{
    '@type':'PostalAddress',
    'streetAddress':'1303 Pearl St',
    'addressLocality':CITY,
    'addressRegion':STATE_CODE,
    'postalCode':POSTAL,
    'addressCountry':CC
  },
  'geo':{'@type':'GeoCoordinates','latitude':LAT,'longitude':LNG},
  'hasMap':MAPS_SHARE,
  'sameAs':[MAPS_SHARE, GOVT_TOURISM],
  'openingHoursSpecification':[{
    '@type':'OpeningHoursSpecification',
    'dayOfWeek':['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'],
    'opens':'00:00','closes':'23:59'
  }]
};

const breadcrumbLd:any = {
  '@context':'https://schema.org',
  '@type':'BreadcrumbList',
  'itemListElement':[
    {'@type':'ListItem','position':1,'name':FULL_NAME,'item':siteUrl},
    {'@type':'ListItem','position':2,'name':CITY,'item':`${siteUrl}/#${CITY.toLowerCase()}`},
    {'@type':'ListItem','position':3,'name':STATE,'item':`${siteUrl}/#${STATE_CODE.toLowerCase()}`},
    {'@type':'ListItem','position':4,'name':COUNTRY,'item':`${siteUrl}/#${CC.toLowerCase()}`}
  ]
};

const faqs = [
  ['Where is Pearl Street Mall located?',`${FULL_NAME} is located at 1303 Pearl St, ${CITY}, ${STATE} ${POSTAL}, ${COUNTRY}, near 13th Street in the pedestrian core of downtown.`],
  ['Is Pearl Street Mall free to visit?','Yes. The pedestrian mall itself is a public outdoor space with no admission fee. Purchases, dining, performances and ticketed events are separate.'],
  ['When is the best time to visit?','Late morning through early evening gives you the broadest mix of open shops, patios and street activity. Summer evenings are lively; shoulder seasons are calmer.'],
  ['How long should I plan to stay?','About 1.5–3 hours works well for a first visit, with more time if you plan a meal, shopping, a museum stop or an event.'],
  ['Where should I park?','City of Boulder operates multiple downtown garages close to Pearl Street, including 15th & Pearl, 14th & Walnut, 11th & Walnut and 11th & Spruce. Check current city rates before arrival.'],
  ['Are business hours the same as the mall hours?','No. The outdoor pedestrian space is accessible at all hours, but every shop, restaurant, visitor service and event sets its own schedule.'],
  ['What is there to do near Pearl Street Mall?',`Within a short walk you can explore nearby landmarks such as ${NEARBY_1} and ${NEARBY_2}, plus Boulder’s shops, dining and creek-side trails.`]
];
const faqLd = {'@context':'https://schema.org','@type':'FAQPage',mainEntity:faqs.map(([q,a])=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}}))};
---
<!doctype html>
<html lang="en-US">
<head>
<meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/>
<!-- 2. TDK / Meta + OG -->
<title>{FULL_NAME} ({CITY}) - Visitor Guide &amp; Location</title>
<meta name="description" content={`Discover ${FULL_NAME}, the iconic pedestrian mall in ${CITY}, ${STATE}, ${COUNTRY}. View the location map, opening details, nearby ${NEARBY_1}, and practical travel tips.`}/>
<link rel="canonical" href={canonical}/>
<meta property="og:title" content={`${FULL_NAME} - ${CITY} Travel Guide`}/>
<meta property="og:description" content={`Official visitor guide to ${FULL_NAME} in ${CITY}, ${STATE}, ${COUNTRY}.`}/>
<meta property="og:url" content={canonical}/>
<meta property="og:type" content="website"/>
<meta property="og:image" content={ogImage}/>
<meta property="og:image:alt" content={`${FULL_NAME} in ${CITY}`}/>
<meta name="twitter:card" content="summary_large_image"/>
<meta name="theme-color" content="#1e2926"/>
<link rel="manifest" href="/manifest.webmanifest"/>
<link rel="icon" href="/favicon.svg" type="image/svg+xml"/><link rel="icon" href="/favicon-32.png" sizes="32x32"/><link rel="icon" href="/favicon-16.png" sizes="16x16"/><link rel="apple-touch-icon" href="/apple-touch-icon.png"/>
<script async src="https://www.googletagmanager.com/gtag/js?id=G-HXM22WWPKP"></script><script is:inline>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-HXM22WWPKP');</script>
<script type="application/ld+json" set:html={JSON.stringify(placeLd)}></script>
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)}></script>
<script type="application/ld+json" set:html={JSON.stringify(faqLd)}></script>
<script is:inline>if('serviceWorker' in navigator){window.addEventListener('load',()=>{navigator.serviceWorker.register('/sw.js').catch(()=>{});});}</script>
</head>
<body>
<header class="absolute inset-x-0 top-0 z-30"><div class="mx-auto flex max-w-7xl items-center justify-between px-5 py-5"><a href="#top" class="focus-ring rounded-xl bg-[#f7f0e4]/95 p-2 shadow-lg"><img src="/logo.svg" width="210" height="63" alt={FULL_NAME}/></a><nav class="hidden gap-6 rounded-full bg-[#1e2926]/80 px-6 py-3 text-sm font-semibold text-white backdrop-blur md:flex"><a href="#about">About</a><a href="#plan">Plan</a><a href="#eat">Eat</a><a href="#nearby">Nearby</a><a href="#faq">FAQ</a></nav></div></header>
<main id="top">
<section class="relative min-h-[92vh] overflow-hidden bg-[#1e2926] text-white"><img src={photo.hero} alt={`${FULL_NAME} pedestrian promenade in ${CITY}`} class="absolute inset-0 h-full w-full object-cover opacity-70"/><div class="absolute inset-0 bg-gradient-to-t from-[#17211e] via-[#17211e]/30 to-transparent"></div><div class="relative mx-auto flex min-h-[92vh] max-w-7xl items-end px-5 pb-16 pt-36"><div class="max-w-4xl"><div class="mb-5 inline-flex rounded-full border border-white/30 bg-black/20 px-4 py-2 text-xs font-bold uppercase tracking-[.2em] backdrop-blur">Four brick blocks • Downtown {CITY}</div><h1 class="font-serif text-[clamp(4rem,11vw,9rem)] leading-[.78] tracking-[-.055em]">{FULL_NAME.split(' ')[0]}<br/>{FULL_NAME.split(' ').slice(1).join(' ')}</h1><p class="mt-5 text-sm font-semibold uppercase tracking-[.16em] text-white/80">{CITY}, {STATE} · {COUNTRY}</p><p class="mt-7 max-w-2xl text-lg leading-8 text-white/88">Boulder’s pedestrian heart: historic storefronts, mountain-town energy, patios, independent shops, public art and the kind of street performance that makes you stop mid-walk.</p><div class="mt-8 flex flex-wrap gap-3 text-sm"><span class="rounded-full bg-[#f7f0e4] px-4 py-2 font-bold text-[#1e2926]">★ {RATING} · {REVIEWS} reviews</span><span class="rounded-full border border-white/35 px-4 py-2">Free public space</span><span class="rounded-full border border-white/35 px-4 py-2">11th–15th Streets</span></div><p class="mt-3 text-xs text-white/70">评分与评价数同步自谷歌地图（Google Maps）用户评价 · {SYNC_LABEL} · <a href={MAPS_SHARE} target="_blank" rel="noopener" class="underline">点击查看谷歌地图全部评价↗</a></p></div></div></section>

<section id="about" class="brick-grid px-5 py-24"><div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-[1.2fr_.8fr]"><div><p class="eyebrow">Why it feels like {CITY}</p><h2 class="section-title mt-3">About {FULL_NAME}</h2><p class="mt-3 max-w-2xl text-lg leading-8 text-black/70">Not a mall. A civic living room.</p><p class="mt-7 max-w-2xl text-lg leading-8 text-black/70">Welcome to <b>{FULL_NAME}</b>, widely recognized as the central <b>{SHORT_NAME}</b>. Located in the heart of <b>{CITY}</b>, <b>{STATE}</b>, <b>{COUNTRY}</b>, this destination serves as a primary hub for travelers visiting the region.</p><p class="mt-4 text-sm font-semibold text-black/55">{FULL_NAME} → {CITY} → {STATE} → {COUNTRY}</p><h2 class="section-title mt-10 text-[clamp(1.6rem,3vw,2.6rem)]">History &amp; Significance of {FULL_NAME}</h2><p class="mt-5 max-w-2xl text-lg leading-8 text-black/70">The four-block pedestrian mall opened as a public park in 1977 after Boulder converted this stretch of Pearl Street from car traffic into a walk-first urban space. Brick paving, gathering nodes, play features, trees and street-scale retail remain the defining experience.</p></div><div class="card p-7"><p class="font-serif text-3xl">Quick read</p><dl class="mt-6 grid grid-cols-2 gap-5 text-sm"><div><dt class="text-black/45">Address</dt><dd class="mt-1 font-bold">1303 Pearl St<br/>{CITY}, {STATE_CODE} {POSTAL}</dd></div><div><dt class="text-black/45">Phone</dt><dd class="mt-1 font-bold">303-449-3774</dd></div><div><dt class="text-black/45">Core length</dt><dd class="mt-1 font-bold">4 pedestrian blocks</dd></div><div><dt class="text-black/45">Best pace</dt><dd class="mt-1 font-bold">1.5–3 hours</dd></div></dl></div></div></section>

<section class="bg-[#9f3f2f] px-5 py-24 text-[#fffaf2]"><div class="mx-auto max-w-7xl"><p class="text-xs font-bold uppercase tracking-[.18em] text-[#f2c98e]">Street character</p><div class="mt-5 grid gap-5 md:grid-cols-3"><figure class="overflow-hidden rounded-[2rem]"><img src={photo.summer} class="h-96 w-full object-cover" alt="Tree-lined brick walk on Pearl Street Mall"/><figcaption class="p-4 text-sm text-white/75">Tree shade + brick paving</figcaption></figure><figure class="overflow-hidden rounded-[2rem] md:translate-y-12"><img src={photo.lawn} class="h-96 w-full object-cover" alt="Pearl Street Mall seen from courthouse lawn"/><figcaption class="p-4 text-sm text-white/75">Civic spaces woven into downtown</figcaption></figure><figure class="overflow-hidden rounded-[2rem]"><img src={photo.performer} class="h-96 w-full object-cover" alt="Street performer on Pearl Street"/><figcaption class="p-4 text-sm text-white/75">Buskers are part of the rhythm</figcaption></figure></div></div></section>

<section id="plan" class="px-5 py-24"><div class="mx-auto max-w-7xl"><p class="eyebrow">Plan your visit</p><h2 class="section-title mt-3">Location &amp; How to Visit {SHORT_NAME} in {CITY}</h2><p class="mt-3 max-w-2xl text-lg text-black/70">Make the bricks easy.</p><div class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-4"><article class="card p-6"><h3 class="font-serif text-2xl">Fees</h3><p class="mt-3 leading-7 text-black/65">No admission fee for the pedestrian mall. Shopping, meals and ticketed programs are separate.</p></article><article class="card p-6"><h3 class="font-serif text-2xl">Best time</h3><p class="mt-3 leading-7 text-black/65">Late morning to early evening for the fullest mix of businesses and street life. Summer evenings are the most animated.</p></article><article class="card p-6"><h3 class="font-serif text-2xl">Stay length</h3><p class="mt-3 leading-7 text-black/65">1.5–3 hours for browsing and a snack; half a day if you add a sit-down meal, museum or nearby trail.</p></article><article class="card p-6"><h3 class="font-serif text-2xl">Accessibility</h3><p class="mt-3 leading-7 text-black/65">The city lists accessible sidewalks/paths, benches and drinking fountains. Cross-street grades and crowds can vary.</p></article></div>
<div class="mt-16 grid gap-6 lg:grid-cols-2"><article class="card p-8"><p class="eyebrow">Detailed transportation</p><h3 class="mt-2 font-serif text-3xl">Arrive without the circling.</h3><div class="mt-6 space-y-5 leading-7 text-black/68"><p><b>By bus:</b> Downtown Boulder is served by RTD; the downtown station sits near 14th & Walnut, roughly a block from the mall.</p><p><b>By bike:</b> Boulder’s bike network connects downtown with the Boulder Creek corridor. Use signed bike parking and walk your bike when crowds are dense.</p><p><b>On foot:</b> The core pedestrian mall runs from 11th to 15th Street; Pearl Street continues beyond both ends with more shops and dining.</p></div></article><article class="card p-8"><p class="eyebrow">Parking</p><h3 class="mt-2 font-serif text-3xl">Use a city garage first.</h3><p class="mt-5 leading-7 text-black/68">Convenient downtown garages include 15th & Pearl, 14th & Walnut, 11th & Walnut and 11th & Spruce. City garage pricing changes, so confirm rates before arrival; weekends and city holidays are often free in downtown city garages, with listed exceptions.</p><p class="mt-4 rounded-2xl bg-[#eef1e9] p-4 text-sm">Tip: special events can fill the closest facilities quickly. A garage two or three blocks away is often faster than hunting curb space.</p></article></div></div></section>

<section id="eat" class="bg-[#294e3d] px-5 py-24 text-white"><div class="mx-auto max-w-7xl"><p class="text-xs font-bold uppercase tracking-[.18em] text-[#e6bf82]">Food nearby</p><h2 class="section-title mt-3">Eat right on the walk.</h2><div class="mt-10 grid gap-5 md:grid-cols-3"><article class="rounded-3xl bg-white/9 p-7"><h3 class="font-serif text-3xl">OAK at Fourteenth</h3><p class="mt-3 leading-7 text-white/70">Seasonal New American cooking and cocktails directly on Pearl Street.</p><p class="mt-4 text-sm font-bold text-[#f0cc92]">1400 Pearl St</p></article><article class="rounded-3xl bg-white/9 p-7"><h3 class="font-serif text-3xl">The Kitchen</h3><p class="mt-3 leading-7 text-white/70">Modern American bistro with a lively downtown dining room.</p><p class="mt-4 text-sm font-bold text-[#f0cc92]">1039 Pearl St</p></article><article class="rounded-3xl bg-white/9 p-7"><h3 class="font-serif text-3xl">Postino Boulder</h3><p class="mt-3 leading-7 text-white/70">Wine-café energy, shareable boards and a wraparound patio near the east end.</p><p class="mt-4 text-sm font-bold text-[#f0cc92]">1468 Pearl St</p></article></div><p class="mt-6 text-sm text-white/55">Restaurant hours and menus change; verify directly before making a special trip.</p></div></section>

<section id="nearby" class="px-5 py-24"><div class="mx-auto max-w-7xl"><p class="eyebrow">Nearby sights</p><h2 class="section-title mt-3">Landmarks &amp; Attractions Around {SHORT_NAME}</h2><p class="mt-3 max-w-2xl text-lg text-black/70">Add one more Boulder layer.</p><p class="mt-5 max-w-2xl leading-8 text-black/65">When visiting <b>{FULL_NAME}</b>, visitors can easily explore surrounding historical landmarks and points of interest, including <b>{NEARBY_1}</b> and <b>{NEARBY_2}</b>.</p><div class="mt-10 grid gap-5 lg:grid-cols-3"><article class="card p-7"><span class="text-4xl">▰</span><h3 class="mt-6 font-serif text-3xl">Museum of Boulder</h3><p class="mt-3 leading-7 text-black/65">A compact local-history stop north of Pearl Street, easy to pair with shopping.</p></article><article class="card p-7"><span class="text-4xl">◒</span><h3 class="mt-6 font-serif text-3xl">Boulder Creek Path</h3><p class="mt-3 leading-7 text-black/65">A quick shift from downtown brick to creekside walking and biking.</p></article><article class="card p-7"><span class="text-4xl">▲</span><h3 class="mt-6 font-serif text-3xl">The People’s Crossing</h3><p class="mt-3 leading-7 text-black/65">At the west end of Pearl, a trailhead gives a fast taste of Boulder’s red-rock foothills.</p></article></div></div></section>

<section class="px-5 pb-24"><div class="mx-auto max-w-7xl overflow-hidden rounded-[2rem] bg-[#1e2926]"><div class="grid lg:grid-cols-[.72fr_1.28fr]"><div class="p-8 text-white lg:p-12"><p class="text-xs font-bold uppercase tracking-[.18em] text-[#e6bf82]">Map</p><h2 class="mt-3 font-serif text-4xl">Find the center of the bricks.</h2><p class="mt-5 leading-7 text-white/65">The Visitor Information Center is at 1303 Pearl Street, near 13th Street, right in the pedestrian core.</p><a class="focus-ring mt-7 inline-block rounded-full bg-[#f7f0e4] px-5 py-3 text-sm font-bold text-[#1e2926]" href={MAPS_SHARE} target="_blank" rel="noopener">Open in Google Maps ↗</a></div><iframe class="min-h-[480px] w-full border-0" src={mapUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="Google Map of Pearl Street Mall"></iframe></div></div></section>

<section id="reviews" class="bg-[#efe4d2] px-5 py-24"><div class="mx-auto max-w-5xl"><p class="eyebrow">Visitor ratings</p><h2 class="section-title mt-3">Rated by travelers on Google Maps.</h2><div class="mt-8 flex flex-wrap items-center gap-6"><div class="font-serif text-[#1e2926]"><span class="text-6xl font-bold">{RATING}</span><span class="ml-1 text-2xl align-top text-[#9f3f2f]">★</span></div><div><p class="text-lg font-bold">{REVIEWS} Google Maps reviews</p><p class="mt-1 max-w-xl text-sm text-black/60">同步自 Google 地图用户评价，同步时间 {SYNC_LABEL}；版权归原作者与 Google 地图所有</p></div></div><a class="focus-ring mt-7 inline-block rounded-full bg-[#9f3f2f] px-5 py-3 text-sm font-bold text-white" href={MAPS_SHARE} target="_blank" rel="noopener">在谷歌地图查看全部评价 ↗</a></div></section>

<section id="faq" class="px-5 py-24"><div class="mx-auto max-w-5xl"><p class="eyebrow">FAQ</p><h2 class="section-title mt-3">Before you go.</h2><div class="mt-10 divide-y divide-black/10">{faqs.map(([q,a])=><details class="group py-5"><summary class="cursor-pointer list-none font-serif text-2xl font-bold">{q}<span class="float-right text-[#9f3f2f] group-open:rotate-45">+</span></summary><p class="mt-4 max-w-3xl leading-7 text-black/65">{a}</p></details>)}</div></div></section>

<section id="sources" class="px-5 py-16"><div class="mx-auto max-w-7xl text-sm text-black/55"><p class="eyebrow">资料来源</p><h2 class="section-title mt-3 text-2xl">Sources &amp; attribution</h2><ul class="mt-5 space-y-3"><li><b>评价</b> · 同步时间 {SYNC_LABEL} — 同步自 Google 地图用户评价，同步时间 {SYNC_LABEL}；版权归原作者与 Google 地图所有。<a href={MAPS_SHARE} target="_blank" rel="noopener" class="underline">在谷歌地图查看全部评价↗</a></li><li><b>地图</b> — Google 地图分享链接（Plus Code 2P9C+8G，{CITY}, {STATE_CODE}），嵌入代码来源 Google Maps。</li><li><b>官方旅游信息</b> — <a href={GOVT_TOURISM} target="_blank" rel="noopener noreferrer" class="underline">{COUNTRY} / {STATE} Official Tourism Portal</a>。</li><li><b>图片版权</b> — Wikimedia Commons images used under their listed Creative Commons licenses. Primary recent streetscape: Jesse James, CC BY 4.0; classic mall photo: Lee Coursey, CC BY 2.0; courthouse lawn: Kvng, CC BY-SA 3.0. See source file pages on Wikimedia Commons for full attribution.</li></ul></div></section>
</main><footer class="bg-[#17211e] px-5 py-10 text-sm text-white/60"><div class="mx-auto flex max-w-7xl flex-col gap-4 md:flex-row md:items-center md:justify-between"><img src="/logo.svg" width="190" height="57" alt={FULL_NAME}/><p>This independent visitor guide is not an official City of Boulder or Downtown Boulder website.</p></div></footer>
</body></html>
