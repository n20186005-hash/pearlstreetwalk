---
import Guide from '../layouts/Guide.astro';
import { guidePages } from '../data/pages/index';

// Prerendered so no wildcard SSR route can intercept static asset requests.
export const prerender = true;
export function getStaticPaths() {
  return guidePages.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}
const { page } = Astro.props;
---
<Guide page={page} />
