---
import Base from '../layouts/Base.astro';
export const prerender=false;
Astro.response.status=404;
---
<Base title="Page not found | Pearl Street Mall guide" description="This address does not match a guide page. Return to the Pearl Street Mall visitor guide." path="/404" noindex={true}><section class="section"><div class="container narrow"><h1 class="section-title">Page not found</h1><p>This address has no matching page. Choose a section from the menu or return to the guide.</p><a class="button" href="/">Return to the guide</a></div></section></Base>
